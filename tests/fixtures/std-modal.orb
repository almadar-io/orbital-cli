          "linkedEntityId": "ent_01M281A464TVRCM01WXQQVMC43",
          "name": "ModalRecordModal",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M281A4646ZXP6YW7MS5KQ47F",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "A request to display the modal window.",
                "id": "evt_01M281A464ZBACF6PGVY44S1J1",
                "key": "OPEN",
                "name": "Open",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  },
                  {
                    "entity": "ModalRecord",
                    "name": "row",
                    "properties": [
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "name",
                        "type": "string"
                      },
                      {
                        "name": "description",
                        "type": "string"
                      },
                      {
                        "name": "status",
                        "type": "string"
                      },
                      {
                        "name": "createdAt",
                        "type": "string"
                      }
                    ],
                    "type": "object"
                  }
                ],
                "synonyms": "show, display, present, reveal",
                "tier": "essential"
              },
              {
                "description": "Indicates the modal window is being closed.",
                "id": "evt_01M281A464S3DTRD3DGS41BAMK",
                "key": "CLOSE",
                "name": "Close",
                "synonyms": "dismiss, hide, cancel",
                "tier": "essential"
              },
              {
                "description": "Indicates a successful data save operation.",
                "id": "evt_01M281A464H4JZR88QQGE2FFVJ",
                "key": "SAVE",
                "name": "Save",
                "payloadSchema": [
                  {
                    "name": "data",
                    "required": true,
                    "type": "@entity"
                  }
                ],
                "synonyms": "submit, persist, confirm",
                "tier": "essential"
              },
              {
                "description": "Indicates a failure to load the record data.",
                "id": "evt_01M281A464MAPRB44P5TVDXW76",
                "key": "ModalRecordLoadFailed",
                "name": "ModalRecord load failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "type": "string"
                  },
                  {
                    "name": "code",
                    "type": "string"
                  }
                ],
                "synonyms": "error, failure, problem, unsuccessful",
                "tier": "internal"
              },
              {
                "description": "Signals that the modal's data has been successfully loaded.",
                "id": "evt_01M281A464BMHMM9Z4601T2MEK",
                "key": "ModalRecordLoaded",
                "name": "ModalRecord loaded",
                "payloadSchema": [
                  {
                    "entity": "ModalRecord",
                    "name": "data",
                    "properties": [
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "name",
                        "type": "string"
                      },
                      {
                        "name": "description",
                        "type": "string"
                      },
                      {
                        "name": "status",
                        "type": "string"
                      },
                      {
                        "name": "createdAt",
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ],
                "synonyms": "loaded, data ready, populated",
                "tier": "essential"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "closed"
              },
              {
                "name": "open"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "ModalRecord",
                    {
                      "emit": {
                        "failure": "ModalRecordLoadFailed",
                        "success": "ModalRecordLoaded"
                      }
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M281A4646ZXP6YW7MS5KQ47F",
                "from": "closed",
                "to": "closed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.id",
                    "@payload.id"
                  ],
                  [
                    "render-ui",
                    "@config.detailSlot",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "name": "@config.icon",
                              "type": "icon"
                            },
                            {
                              "content": "@config.title",
                              "type": "typography",
                              "variant": "h3"
                            }
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "type": "stack"
                        },
                        {
                          "type": "divider"
                        },
                        {
                          "cancelEvent": "CLOSE",
                          "entity": "@payload.row",
                          "fields": "@config.fields",
                          "mode": "@config.mode",
                          "submitEvent": "SAVE",
                          "type": "form-section"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "@config.detailPattern"
                    }
                  ]
                ],
                "event": "OPEN",
                "eventId": "evt_01M281A464ZBACF6PGVY44S1J1",
                "from": "closed",
                "guard": [
                  "or",
                  [
                    "=",
                    "@config.mode",
                    "create"
                  ],
                  "@payload.row"
                ],
                "to": "open"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "@config.detailSlot",
                    null
                  ],
                  [
                    "render-ui",
                    "toast",
                    {
                      "dismissible": true,
                      "message": "Cancelled",
                      "type": "alert",
                      "variant": "info"
                    }
                  ]
                ],
                "event": "CLOSE",
                "eventId": "evt_01M281A464S3DTRD3DGS41BAMK",
                "from": "open",
                "to": "closed"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "@config.detailSlot",
                    null
                  ]
                ],
                "event": "SAVE",
                "eventId": "evt_01M281A464H4JZR88QQGE2FFVJ",
                "from": "open",
                "to": "closed"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}